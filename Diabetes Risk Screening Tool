th;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_d1c7d8bc-4675-44fa-8c44-adbf9a77754a\", \"diabetes_risk_model.pkl\", 3322)"]},"metadata":{}}]},{"cell_type":"code","source":["!pip install -q streamlit pyngrok"],"metadata":{"id":"75ENHE4Szb_T","executionInfo":{"status":"ok","timestamp":1794638736445,"user_tz":-120,"elapsed":8802,"user":{"displayName":"Hatem Elhadry","userId":"12673594480043923683"}}},"execution_count":44,"outputs":[]},{"cell_type":"code","source":["\n","%%writefile app.py\n","\n","import streamlit as st\n","import pandas as pd\n","import joblib\n","\n","# =========================\n","# PAGE CONFIGURATION\n","# =========================\n","\n","st.set_page_config(\n","    page_title=\"Diabetes Risk Screening\",\n","    page_icon=\"🩺\",\n","    layout=\"centered\"\n",")\n","\n","# =========================\n","# CUSTOM CSS DESIGN\n","# =========================\n","\n","st.markdown(\"\"\"\n","<style>\n","\n","/* Main background */\n",".stApp {\n","    background: linear-gradient(135deg, #eef7f8 0%, #f4f7fc 55%, #edf3fa 100%);\n","}\n","\n","/* Main content width */\n",".block-container {\n","    max-width: 900px;\n","    padding-top: 2rem;\n","    padding-bottom: 3rem;\n","}\n","\n","/* Header */\n",".hero {\n","    background: linear-gradient(120deg, #087f8c, #145b83);\n","    padding: 35px 30px;\n","    border-radius: 20px;\n","    color: white;\n","    text-align: center;\n","    margin-bottom: 25px;\n","    box-shadow: 0 8px 25px rgba(8, 127, 140, 0.18);\n","}\n","\n",".hero h1 {\n","    color: white;\n","    font-size: 32px;\n","    margin-bottom: 10px;\n","    font-weight: 750;\n","}\n","\n",".hero p {\n","    color: #e1f5f5;\n","    font-size: 15px;\n","    margin-bottom: 0;\n","}\n","\n","/* Section headings */\n",".section-title {\n","    color: #126477;\n","    font-size: 21px;\n","    font-weight: 700;\n","    margin-top: 12px;\n","    margin-bottom: 5px;\n","}\n","\n","/* Form card */\n","div[data-testid=\"stForm\"] {\n","    background: rgba(255, 255, 255, 0.92);\n","    padding: 25px;\n","    border: 1px solid #dcebed;\n","    border-radius: 18px;\n","    box-shadow: 0 5px 20px rgba(35, 75, 95, 0.06);\n","}\n","\n","/* Input labels */\n","label {\n","    color: #244b5a !important;\n","    font-weight: 550 !important;\n","}\n","\n","/* Input fields */\n","div[data-baseweb=\"select\"] > div,\n","div[data-baseweb=\"input\"] > div {\n","    border-radius: 10px;\n","    border-color: #d5e5e9;\n","}\n","\n","/* Submit button */\n","div.stFormSubmitButton > button {\n","    width: 100%;\n","    background: linear-gradient(100deg, #078b91, #126b91);\n","    color: white;\n","    border: none;\n","    border-radius: 12px;\n","    padding: 13px;\n","    font-size: 17px;\n","    font-weight: 700;\n","    transition: 0.2s;\n","}\n","\n","div.stFormSubmitButton > button:hover {\n","    background: linear-gradient(100deg, #066e78, #104f78);\n","    color: white;\n","    border: none;\n","}\n","\n","/* Result cards */\n",".result-card {\n","    background: white;\n","    padding: 25px;\n","    border-radius: 18px;\n","    border: 1px solid #dcebed;\n","    box-shadow: 0 5px 20px rgba(35, 75, 95, 0.07);\n","    margin-top: 15px;\n","    text-align: center;\n","}\n","\n",".result-score {\n","    font-size: 42px;\n","    font-weight: 800;\n","    color: #087f8c;\n","    margin: 8px 0;\n","}\n","\n",".result-label {\n","    color: #55717e;\n","    font-size: 14px;\n","}\n","\n","/* Footer */\n",".footer {\n","    text-align: center;\n","    color: #718995;\n","    font-size: 12px;\n","    margin-top: 35px;\n","    padding: 15px;\n","}\n","\n","</style>\n","\"\"\", unsafe_allow_html=True)\n","\n","\n","# =========================\n","# LOAD MODEL\n","# =========================\n","\n","@st.cache_resource\n","def load_bundle():\n","    return joblib.load(\"diabetes_risk_model.pkl\")\n","\n","\n","bundle = load_bundle()\n","\n","model = bundle[\"model\"]\n","threshold = bundle[\"threshold\"]\n","features = bundle[\"features\"]\n","model_name = bundle[\"model_name\"]\n","\n","\n","# =========================\n","# APP HEADER\n","# =========================\n","\n","st.markdown(\"\"\"\n","<div class=\"hero\">\n","    <div style=\"font-size:45px;\">🩺</div>\n","    <h1>Diabetes Risk Screening</h1>\n","    <p>\n","        Understand your health indicators through\n","        a machine learning screening tool.\n","    </p>\n","</div>\n","\"\"\", unsafe_allow_html=True)\n","\n","st.info(\n","    \"This tool is designed for educational screening support only. \"\n","    \"It is not a medical diagnosis and does not replace laboratory testing \"\n","    \"or professional medical advice.\"\n",")\n","\n","\n","# =========================\n","# SCREENING FORM\n","# =========================\n","\n","with st.form(\"screening_form\"):\n","\n","    st.markdown(\n","        '<p class=\"section-title\">❤️ Health Conditions</p>',\n","        unsafe_allow_html=True\n","    )\n","\n","    high_bp = st.selectbox(\n","        \"Have you ever been told you have high blood pressure?\",\n","        [0, 1],\n","        format_func=lambda x: \"No\" if x == 0 else \"Yes\"\n","    )\n","\n","    high_chol = st.selectbox(\n","        \"Have you ever been told you have high cholesterol?\",\n","        [0, 1],\n","        format_func=lambda x: \"No\" if x == 0 else \"Yes\"\n","    )\n","\n","    chol_check = st.selectbox(\n","        \"Have you had your cholesterol checked in the past 5 years?\",\n","        [0, 1],\n"